{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promptbranch.release_attempt.schema.json",
  "title": "Promptbranch canonical release attempt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schema_version",
    "attempt_id",
    "repo_id",
    "baseline_version",
    "target_version",
    "release_type",
    "state",
    "evidence",
    "transitions",
    "lifecycle_complete",
    "next_transition"
  ],
  "properties": {
    "schema": {"const": "promptbranch.release_attempt"},
    "schema_version": {"const": "2.0"},
    "attempt_id": {"type": "string", "minLength": 1},
    "repo_id": {"type": "string", "minLength": 1},
    "baseline_version": {"type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+){2,}$"},
    "target_version": {"type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+){2,}$"},
    "release_type": {"enum": ["normal", "repair"]},
    "state": {
      "enum": [
        "DECLARED",
        "ARTIFACT_BOUND",
        "ARTIFACT_VERIFIED",
        "CANDIDATE_REGISTERED",
        "RUNTIME_PREPARED",
        "TESTED_GREEN",
        "ACCEPTED",
        "ADOPTED_CURRENT",
        "FINAL_VERIFIED"
      ]
    },
    "failure_state": {"type": ["string", "null"], "enum": [null, "BLOCKED_RETRYABLE", "FAILED_TERMINAL"]},
    "failure": {"type": ["object", "null"]},
    "artifact": {"type": ["object", "null"]},
    "evidence": {"type": "object"},
    "transitions": {"type": "array", "items": {"type": "object"}},
    "lifecycle_complete": {"type": "boolean"},
    "next_transition": {
      "type": ["string", "null"],
      "enum": [
        null,
        "ARTIFACT_BOUND",
        "ARTIFACT_VERIFIED",
        "CANDIDATE_REGISTERED",
        "RUNTIME_PREPARED",
        "TESTED_GREEN",
        "ACCEPTED",
        "ADOPTED_CURRENT",
        "FINAL_VERIFIED"
      ]
    }
  }
}
