{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptbranch.local/schemas/release-set.schema.json",
  "title": "Promptbranch release-set manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "release_set_id", "project_id", "repositories"],
  "properties": {
    "schema": {"const": "promptbranch.release_set"},
    "schema_version": {"const": "1.0"},
    "release_set_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo_id", "target"],
        "properties": {
          "repo_id": {"type": "string", "minLength": 1},
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "artifact"],
            "properties": {
              "version": {"type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+){2,}$"},
              "artifact": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*_v[0-9]+(?:\\.[0-9]+){2,}\\.zip$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "local_path": {"type": "string", "minLength": 1}
            }
          },
          "depends_on": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repo_id", "constraint"],
              "properties": {
                "repo_id": {"type": "string", "minLength": 1},
                "constraint": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
