{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptbranch.local/schemas/release-set-rollout-evidence.schema.json",
  "title": "Promptbranch release-set rollout evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schema_version",
    "action",
    "status",
    "release_set_id",
    "project_id",
    "plan_sha256",
    "events",
    "repository_results",
    "rollback_results",
    "final_event_sha256",
    "evidence_sha256"
  ],
  "properties": {
    "schema": {
      "const": "promptbranch.release_set.rollout.evidence"
    },
    "schema_version": {
      "const": "1.0"
    },
    "action": {
      "const": "release_set_apply"
    },
    "status": {
      "enum": [
        "release_set_rollout_verified",
        "release_set_rollout_failed_rollback_verified",
        "release_set_rollout_failed_rollback_incomplete"
      ]
    },
    "release_set_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "recorded_at",
          "kind",
          "previous_event_sha256",
          "details",
          "event_sha256"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "recorded_at": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "repo_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "previous_event_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "details": {
            "type": "object"
          },
          "event_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "repository_results": {
      "type": "array"
    },
    "rollback_results": {
      "type": "array"
    },
    "final_event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resume_count": {
      "type": "integer",
      "minimum": 1
    },
    "resume_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resume_sequence",
          "resumed_at",
          "checkpoint_sha256",
          "reconciliation_sha256",
          "mode"
        ],
        "properties": {
          "resume_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "resumed_at": {
            "type": "string",
            "minLength": 1
          },
          "prior_evidence_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "checkpoint_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reconciliation_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mode": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "last_reconciliation": {
      "type": "object"
    }
  }
}
