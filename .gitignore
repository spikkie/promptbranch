__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Build/package outputs
build/
dist/
*.egg-info/
promptbranch.egg-info/
*.zip
*.tar.gz
# Local virtual environments
.venv/
venv/
# Local secrets/environment
.env
.env.*
!.env.example
# Logs and local release/test output
*.log
*.log.*
session_*.log
release_logs/
pb_*.json
pb_*.report.json
# Local browser/profile state
.pb_profile/
.pb_profile_docker/
.pb_profile_local_debug/
.pb_profile_local_debug_pools/
profile/
# Debug/generated probes
coverage/
debug_artifacts/
debug_projects_popup_/
task_*.messages
task_*.messages.txt
task_*_message.txt
task_*_final.txt
stdout.json
stderr.txt
task_show_*_messages.txt
*.task.show
task_*.show
.promptbranch-service-start.*.pid
promptbranch-project-list.json
# Kubernetes render output
helm-chart/charts/
.pb_profile_bonnetjes_clean/
# Promptbranch browser profiles - never commit
.pb_profile*
.pb_profile_*
