{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promptbranch.orchestration.evidence.schema.json",
  "title": "Promptbranch Orchestration Evidence",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "stage",
    "checks",
    "decision",
    "created_at",
    "producer"
  ],
  "properties": {
    "schema": {"const": "promptbranch.orchestration.evidence"},
    "schema_version": {"const": "1.0"},
    "stage": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "summary"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "skipped", "blocked", "not_run"]},
          "summary": {"type": "string"},
          "command_optional": {"type": "string"},
          "artifact_optional": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "decision": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
