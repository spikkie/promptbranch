{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promptbranch.orchestration.grill.schema.json",
  "title": "Promptbranch Orchestration Grill Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "stage",
    "project",
    "provider",
    "proposal_status",
    "constraints",
    "questions",
    "acceptance",
    "next_state_recommendation"
  ],
  "properties": {
    "schema": {
      "const": "promptbranch.orchestration.grill"
    },
    "schema_version": {
      "const": "1.0"
    },
    "stage": {
      "type": "string",
      "enum": [
        "G0_intent",
        "G1_mvp",
        "G2_architecture",
        "G3_slice",
        "G4_implementation",
        "G5_release_deployment",
        "G6_maintenance"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "critical_path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "chatgpt",
            "manual_fixture"
          ]
        },
        "critical_path": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "proposal_status": {
      "type": "string",
      "enum": [
        "proposal_only"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_may_execute",
        "promptbranch_must_validate",
        "source_mutation_allowed",
        "artifact_adoption_allowed"
      ],
      "properties": {
        "model_may_execute": {
          "const": false
        },
        "promptbranch_must_validate": {
          "const": true
        },
        "source_mutation_allowed": {
          "const": false
        },
        "artifact_adoption_allowed": {
          "const": false
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "risk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocking_findings",
        "decision"
      ],
      "properties": {
        "blocking_findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "type": "string",
          "enum": [
            "continue",
            "revise",
            "block"
          ]
        }
      }
    },
    "next_state_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "reason"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
