wd=repo, env=env, text=True, capture_output=True, check=True, ) assert "post-release validation passed" in result.stdout log_dir = repo / ".pb_profile" / "release_logs" / version summary = json.loads((log_dir / f"post_release_validation.{version}.summary.json").read_text(encoding="utf-8")) assert summary["ok"] is True assert summary["version"] == version assert summary["target_version"] == target assert (log_dir / f"pb_ask_protocol_smoke.{version}.json").is_file() assert (log_dir / f"pb_artifact_intake_dry_run.{version}.json").is_file() assert (log_dir / f"pb_test.full.{version}.report.json").is_file() assert (log_dir / f"zip_hygiene.{version}.json").is_file() call_text = calls.read_text(encoding="utf-8") assert "promptbranch artifact current --json" in call_text assert f"--target-version {target}" in call_text assert "promptbranch artifact intake --from-last-answer --dry-run --json" in call_text assert "promptbranch test full --json" in call_text assert "promptbranch test report" in call_text assert "artifact adopt" not in call_text assert "src sync" not in call_text PY python3 - <<'PY' from pathlib import Path # version bump focused metadata updates = { 'VERSION': ('v0.0.222\n', 'v0.0.222.1\n'), 'pyproject.toml': ('version = "0.0.222"', 'version = "0.0.222.1"'), 'promptbranch_version.py': ('PACKAGE_VERSION = "0.0.222"', 'PACKAGE_VERSION = "0.0.222.1"'), 'docker-compose.chatgpt-service.yml': ('promptbranch-service:0.0.222', 'promptbranch-service:0.0.222.1'), 'README.md': ('# promptbranch v0.0.222', '# promptbranch v0.0.222.1'), 'tests/test_chatgpt_container_api.py': ('0.0.222', '0.0.222.1'), 'tests/test_promptbranch_container_api.py': ('0.0.222', '0.0.222.1'), 'tests/test_cli_parser.py': ('0.0.222', '0.0.222.1'), 'tests/test_promptbranch_cli.py': ('promptbranch 0.0.222', 'promptbranch 0.0.222.1'), 'tests/test_promptbranch_mcp.py': ('"0.0.222"', '"0.0.222.1"'), } for fname, (old, new) in updates.items(): p=Path(fname) if p.exists(): s=p.read_text(encoding='utf-8') if old in s: s=s.replace(old, new) p.write_text(s, encoding='utf-8') # update specific service version assert in CLI if present p=Path('tests/test_promptbranch_cli.py') s=p.read_text(encoding='utf-8') s=s.replace('assert payload["version"] == "0.0.222"', 'assert payload["version"] == "0.0.222.1"') s=s.replace('assert captured.out.strip() == "promptbranch 0.0.222"', 'assert captured.out.strip() == "promptbranch 0.0.222.1"') p.write_text(s, encoding='utf-8') # User-Agent version string p=Path('promptbranch_cli.py') s=p.read_text(encoding='utf-8') s=s.replace('promptbranch-artifact-intake/0.0.222', 'promptbranch-artifact-intake/0.0.222.1') s=s.replace('v0.0.222 supports --from-last-answer/--from-last-protocol-run only', 'v0.0.222.1 supports --from-last-answer/--from-last-protocol-run only') s=s.replace('error: v0.0.222 supports --from-last-answer/--from-last-protocol-run only', 'error: v0.0.222.1 supports --from-last-answer/--from-last-protocol-run only') p.write_text(s, encoding='utf-8') # README add repair note summary p=Path('README.md') s=p.read_text(encoding='utf-8') marker='## v0.0.222\n' insert='''## v0.0.222.1\n\n- Repair release adding `scripts/post-release-validation.sh`, a validation-only helper for the standard after-release check sequence.\n- The helper runs artifact-current inspection, protocol smoke, artifact-intake dry-run, full test/report, and release ZIP hygiene checks into one versioned log directory.\n- No Artifact Intake MVP slice was advanced; download, migration, adoption, source mutation, and MCP policy behavior remain unchanged.\n\n''' if '## v0.0.222.1' not in s: if marker in s: s=s.replace(marker, insert+marker, 1) else: s += '\n' + insert p.write_text(s, encoding='utf-8') PY cat > docs/repair-v0.0.222.1.md <<'EOF' # Repair release v0.0.222.1 ## Base release `chatgpt_claudecode_workflow_v0.0.222.zip` ## Repair version `chatgpt_claudecode_workflow_v0.0.222.1.zip` ## Reason Add a repeatable post-release validation helper so the operator can run the standard after-release checks with one command and one versioned log directory. This repairs an operational gap in the v0.0.222 release workflow; it does not advance the Artifact Intake MVP scope. ## Files changed - `VERSION` - `pyproject.toml` - `promptbranch_version.py` - `promptbranch_cli.py` - `docker-compose.chatgpt-service.yml` - `README.md` - `scripts/post-release-validation.sh` - `tests/test_promptbranch_shell_scripts.py` - version expectation tests for CLI/container/MCP surfaces - `docs/repair-v0.0.222.1.md` ## Validation performed - `bash -n scripts/post-release-validation.sh` - `python3 -m py_compile` on core Python modules - focused pytest for shell script, version, MCP, artifact, and container surfaces - extracted ZIP verification - ZIP CRC/testzip check - ZIP hygiene check for cache/log/debug/generated artifacts ## Scope confirmation No slice or line was advanced. The repair adds validation tooling only. No changes were made to: - ask/reply protocol schema - reply parsing semantics - artifact download - candidate migration - artifact adoption - Project Source mutation - source sync behavior - MCP write/process policy - rate-limit pacing behavior EOF

