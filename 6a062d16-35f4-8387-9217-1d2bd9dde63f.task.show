nction after run_artifact_intake_step old='''run_artifact_intake_step() { local phase="$1" intake_phase="${phase}" if [[ "${skip_artifact_intake}" -eq 0 ]]; then if [[ "${skip_protocol_smoke}" -eq 0 && "${rc_protocol}" -ne 0 ]]; then printf '{"ok": true, "status": "skipped_due_to_protocol_smoke_failure", "phase": "%s"}\n' "${phase}" > "${intake_log}" echo "artifact intake dry-run skipped because protocol smoke failed" return 0 fi run_step "artifact intake dry-run (${phase})" "${intake_log}" \ "${pb_cmd}" artifact intake --from-last-answer --dry-run --json || { rc_intake=$?; failures=$((failures + 1)); } else printf '{"ok": true, "status": "skipped", "phase": "%s"}\n' "${phase}" > "${intake_log}" fi } ''' new='''run_artifact_intake_step() { local phase="$1" intake_phase="${phase}" if [[ "${skip_artifact_intake}" -eq 0 ]]; then if [[ "${skip_protocol_smoke}" -eq 0 && "${rc_protocol}" -ne 0 ]]; then printf '{"ok": true, "status": "skipped_due_to_protocol_smoke_failure", "phase": "%s"}\n' "${phase}" > "${intake_log}" echo "artifact intake dry-run skipped because protocol smoke failed" return 0 fi run_step "artifact intake dry-run (${phase})" "${intake_log}" \ "${pb_cmd}" artifact intake --from-last-answer --dry-run --json || { rc_intake=$?; failures=$((failures + 1)); } else printf '{"ok": true, "status": "skipped", "phase": "%s"}\n' "${phase}" > "${intake_log}" fi } run_artifact_candidate_run_step() { local phase="$1" candidate_run_phase="${phase}" if [[ "${skip_candidate_run}" -eq 0 ]]; then if [[ "${skip_protocol_smoke}" -eq 0 && "${rc_protocol}" -ne 0 ]]; then printf '{"ok": true, "status": "skipped_due_to_protocol_smoke_failure", "phase": "%s"}\n' "${phase}" > "${candidate_run_log}" echo "artifact candidate-run plan skipped because protocol smoke failed" return 0 fi if [[ "${skip_artifact_intake}" -eq 0 && "${rc_intake}" -ne 0 ]]; then printf '{"ok": true, "status": "skipped_due_to_artifact_intake_failure", "phase": "%s"}\n' "${phase}" > "${candidate_run_log}" echo "artifact candidate-run plan skipped because artifact intake dry-run failed" return 0 fi run_step "artifact candidate-run plan (${phase})" "${candidate_run_log}" \ "${pb_cmd}" artifact candidate-run --json || { rc_candidate_run=$?; failures=$((failures + 1)); } else printf '{"ok": true, "status": "skipped", "phase": "%s"}\n' "${phase}" > "${candidate_run_log}" fi } ''' if old not in s: raise SystemExit('intake function block not found') s=s.replace(old,new) # no adopt branch run candidate s=s.replace(''' run_protocol_smoke_step "pre_adoption" run_artifact_intake_step "pre_adoption"''', ''' run_protocol_smoke_step "pre_adoption" run_artifact_intake_step "pre_adoption" run_artifact_candidate_run_step "pre_adoption"''') # deferred logs s=s.replace(''' echo '{"ok": true, "status": "deferred_until_after_adopt", "reason": "adopt_if_accepted_requires_post_adoption_baseline"}' > "${protocol_log}" echo '{"ok": true, "status": "deferred_until_after_protocol_smoke", "reason": "adopt_if_accepted_requires_post_adoption_protocol_smoke"}' > "${intake_log}"''', ''' echo '{"ok": true, "status": "deferred_until_after_adopt", "reason": "adopt_if_accepted_requires_post_adoption_baseline"}' > "${protocol_log}" echo '{"ok": true, "status": "deferred_until_after_protocol_smoke", "reason": "adopt_if_accepted_requires_post_adoption_protocol_smoke"}' > "${intake_log}" echo '{"ok": true, "status": "deferred_until_after_artifact_intake", "reason": "candidate_run_plan_uses_post_adoption_lifecycle_state"}' > "${candidate_run_log}"''') # post adoption run candidate s=s.replace(''' run_protocol_smoke_step "post_adoption" run_artifact_intake_step "post_adoption"''', ''' run_protocol_smoke_step "post_adoption" run_artifact_intake_step "post_adoption" run_artifact_candidate_run_step "post_adoption"''') # skip block s=s.replace(''' if [[ "${skip_artifact_intake}" -eq 0 && "${intake_phase}" == "not_run" ]]; then echo '{"ok": true, "status": "skipped_due_to_pre_protocol_failure", "phase": "post_adoption"}' > "${intake_log}" fi''', ''' if [[ "${skip_artifact_intake}" -eq 0 && "${intake_phase}" == "not_run" ]]; then echo '{"ok": true, "status": "skipped_due_to_pre_protocol_failure", "phase": "post_adoption"}' > "${intake_log}" fi if [[ "${skip_candidate_run}" -eq 0 && "${candidate_run_phase}" == "not_run" ]]; then echo '{"ok": true, "status": "skipped_due_to_pre_protocol_failure", "phase": "post_adoption"}' > "${candidate_run_log}" fi''') # summary args add rc_candidate_run and phase s=s.replace(''' "${rc_intake}" \ "${rc_test_full}"''', ''' "${rc_intake}" \ "${rc_candidate_run}" \ "${rc_test_full}"''') s=s.replace(''' "${protocol_phase}" \ "${intake_phase}" <<'PY' ''', ''' "${protocol_phase}" \ "${intake_phase}" \ "${candidate_run_phase}" <<'PY' ''') # depending actual line has <<'PY' no space? Check and replace alt s=s.replace(''' "${protocol_phase}" \ "${intake_phase}" <<'PY' ''', ''' "${protocol_phase}" \ "${intake_phase}" \ "${candidate_run_phase}" <<'PY' ''') # Python argv unpack s=s.replace(''' rc_intake, rc_test_full,''', ''' rc_intake, rc_candidate_run, rc_test_full,''') s=s.replace(''' protocol_phase, intake_phase, ) = sys.argv[1:]''', ''' protocol_phase, intake_phase, candidate_run_phase, ) = sys.argv[1:]''') # summary step s=s.replace(''' "artifact_intake_dry_run": {"rc": int(rc_intake), "phase": intake_phase}, "test_full": {"rc": int(rc_test_full)},''', ''' "artifact_intake_dry_run": {"rc": int(rc_intake), "phase": intake_phase}, "artifact_candidate_run_plan": {"rc": int(rc_candidate_run), "phase": candidate_run_phase}, "test_full": {"rc": int(rc_test_full)},''') p.write_text(s) PY bash -n scripts/post-release-validation.sh

