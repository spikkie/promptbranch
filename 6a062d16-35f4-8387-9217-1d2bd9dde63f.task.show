om-last-answer/--from-last-protocol-run only') # Insert migration guard in cmd_artifact_intake: replace migration block old=''' if getattr(args, "migrate", False):\n result = _migrate_verified_intake_artifact_candidate(\n result,\n profile_dir=getattr(args, "profile_dir", None) or PROFILE_DIR_NAME,\n repo_path=getattr(args, "repo_path", ".") or ".",\n conversation_id=payload.get("conversation_id"),\n answer_id=answer.get("id"),\n )\n if args.json:\n print(json.dumps(result, indent=2, ensure_ascii=False))\n else:\n print(_render_artifact_intake_result(result), end="")\n return 0 if result.get("ok") else 1\n''' new=''' if getattr(args, "migrate", False):\n result = _artifact_intake_migration_not_supported(result)\n result = _artifact_intake_no_state_mutation_flags(result)\n if args.json:\n print(json.dumps(result, indent=2, ensure_ascii=False))\n else:\n print(_render_artifact_intake_result(result), end="")\n return 0 if result.get("ok") else 1\n''' if old not in s: raise SystemExit('migration block not found') s=s.replace(old,new,1) # Update parser help for dry-run/migrate s=s.replace('Inspect/classify only. This is the default unless --download/--verify/--migrate is also supplied.','Inspect/classify only. This is the default unless --download/--verify is supplied.') s=s.replace('Migrate a verified candidate ZIP from .pb_profile/artifact_inbox/ to the repo root and register it as candidate_release. No adoption or Project Source mutation is performed.','Unsupported in v0.0.223. Artifact intake stops after explicit download and ZIP verification; migration/adoption are later MVP stages.') s=s.replace('Repository root for --migrate. Defaults to the current directory.','Reserved for later migration MVP stages. Ignored except for diagnostics in v0.0.223.') p.write_text(s) PY python3 -m py_compile promptbranch_cli.py

