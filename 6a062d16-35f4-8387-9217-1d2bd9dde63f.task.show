\"status\": \"skipped\", \"phase\": \"${phase}\"}" > "${protocol_log}" fi } run_artifact_intake_step() { local phase="$1" intake_phase="${phase}" if [[ "${skip_artifact_intake}" -eq 0 ]]; then if [[ "${skip_protocol_smoke}" -eq 0 && "${rc_protocol}" -ne 0 ]]; then echo "{\"ok\": true, \"status\": \"skipped_due_to_protocol_smoke_failure\", \"phase\": \"${phase}\"}" > "${intake_log}" echo "artifact intake dry-run skipped because protocol smoke failed" return 0 fi run_step "artifact intake dry-run (${phase})" "${intake_log}" \ "${pb_cmd}" artifact intake --from-last-answer --dry-run --json || { rc_intake=$?; failures=$((failures + 1)); } else echo "{\"ok\": true, \"status\": \"skipped\", \"phase\": \"${phase}\"}" > "${intake_log}" fi } if [[ "${adopt_if_accepted}" -eq 0 ]]; then run_protocol_smoke_step "pre_adoption" run_artifact_intake_step "pre_adoption" else echo echo "===== protocol smoke deferred =====" echo "--adopt-if-accepted defers baseline-dependent protocol smoke until after adoption so --from-current-baseline can resolve to ${version}." echo '{"ok": true, "status": "deferred_until_after_adopt", "reason": "adopt_if_accepted_requires_post_adoption_baseline"}' > "${protocol_log}" echo '{"ok": true, "status": "deferred_until_after_protocol_smoke", "reason": "adopt_if_accepted_requires_post_adoption_protocol_smoke"}' > "${intake_log}" fi ''' s=s[:start]+new+s[end:] # update adopt block small replacements s=s.replace(''' else run_step "artifact adopt" "${adopt_log}" \ "${pb_cmd}" artifact adopt "${artifact_zip}" --from-project-source --json || { rc_adopt=$?; failures=$((failures + 1)); } fi if [[ "${rc_adopt}" -eq 0 ]]; then ''',''' else adopt_performed=1 run_step "artifact adopt" "${adopt_log}" \ "${pb_cmd}" artifact adopt "${artifact_zip}" --from-project-source --json || { rc_adopt=$?; failures=$((failures + 1)); } fi if [[ "${rc_adopt}" -eq 0 && "${adopt_performed}" -eq 1 ]]; then ''') s=s.replace(''' set +e python3 - "${adopt_current_log}" "${version}" > "${adopt_semantic_log}" <<'PYSEMANTIC2' ''',''' adopt_semantic_performed=1 set +e python3 - "${adopt_current_log}" "${version}" > "${adopt_semantic_log}" <<'PYSEMANTIC2' ''') start=s.index('''if [[ "${adopt_if_accepted}" -eq 1 && "${failures}" -eq 0 ]]; then''') # find end of adoption if just before python3 - summary; our previous content from start to next marker includes block. We'll replace tail from block at line 408? Easier find after this start marker to before python3 - summary, modify by insertion before else? Let's inspect current block string end. marker='''else echo echo "===== adopt if accepted skipped =====" echo "adopt_if_accepted=${adopt_if_accepted} failures_before_adopt=${failures}" fi python3 - \\ ''' if marker not in s: raise SystemExit('adopt marker not found') replacement=''' if [[ "${failures}" -eq 0 ]]; then run_protocol_smoke_step "post_adoption" run_artifact_intake_step "post_adoption" else echo echo "===== post-adoption protocol smoke skipped =====" echo "failures_before_post_adoption_protocol=${failures}" if [[ "${skip_protocol_smoke}" -eq 0 && "${protocol_phase}" == "not_run" ]]; then echo '{"ok": true, "status": "skipped_due_to_pre_protocol_failure", "phase": "post_adoption"}' > "${protocol_log}" fi if [[ "${skip_artifact_intake}" -eq 0 && "${intake_phase}" == "not_run" ]]; then echo '{"ok": true, "status": "skipped_due_to_pre_protocol_failure", "phase": "post_adoption"}' > "${intake_log}" fi fi else echo echo "===== adopt if accepted skipped =====" echo "adopt_if_accepted=${adopt_if_accepted} failures_before_adopt=${failures}" fi python3 - \\ ''' s=s.replace(marker,replacement) # add summary args s=s.replace(''' "${adopt_if_accepted}" \ "${require_adopted_baseline}" <<'PY' ''',''' "${adopt_if_accepted}" \ "${require_adopted_baseline}" \ "${adopt_performed}" \ "${adopt_semantic_performed}" \ "${protocol_phase}" \ "${intake_phase}" <<'PY' ''') s=s.replace(''' adopt_if_accepted, require_adopted_baseline, ) = sys.argv[1:] ''',''' adopt_if_accepted, require_adopted_baseline, adopt_performed, adopt_semantic_performed, protocol_phase, intake_phase, ) = sys.argv[1:] ''') s=s.replace(''' "protocol_smoke": {"rc": int(rc_protocol)}, "artifact_intake_dry_run": {"rc": int(rc_intake)}, ''',''' "protocol_smoke": {"rc": int(rc_protocol), "phase": protocol_phase}, "artifact_intake_dry_run": {"rc": int(rc_intake), "phase": intake_phase}, ''') s=s.replace(''' "artifact_adopt": {"rc": int(rc_adopt), "enabled": bool(int(adopt_if_accepted))}, "artifact_current_after_adopt_semantic": {"rc": int(rc_adopt_semantic), "enabled": bool(int(adopt_if_accepted))}, ''',''' "artifact_adopt": {"rc": int(rc_adopt), "enabled": bool(int(adopt_if_accepted)), "performed": bool(int(adopt_performed))}, "artifact_current_after_adopt_semantic": {"rc": int(rc_adopt_semantic), "enabled": bool(int(adopt_if_accepted)), "performed": bool(int(adopt_semantic_performed))}, ''') p.write_text(s) PY bash -n scripts/post-release-validation.sh && nl -ba scripts/post-release-validation.sh | sed -n '212,360p'

