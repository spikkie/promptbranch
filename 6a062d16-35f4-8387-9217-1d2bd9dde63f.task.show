ust not mutate Project Sources, update artifact/source state, or adopt a baseline.\n\n## v0.0.222''',1) p.write_text(s) PY cat VERSION && grep -R "0.0.222.1" -n VERSION pyproject.toml promptbranch_version.py promptbranch_cli.py promptbranch_mcp.py promptbranch_container_api.py chatgpt_container_api.py README.md UPGRADING.md tests | sed -n '1,100p'

