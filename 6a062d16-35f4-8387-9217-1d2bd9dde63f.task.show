n names if re.search(r'(^|/)(\.pytest_cache|__pycache__|\.mypy_cache|\.ruff_cache|build|dist|\.venv|node_modules)(/|$)', n) or n.endswith(('.pyc','.pyo','.log','.pid')) or n.endswith('/.DS_Store') or n.endswith('.zip')] print('testzip', bad) print('entry_count', len(names)) print('wrapper_folder', len(roots)==1 and all('/' in n for n in names)) print('hygiene_count', len(hygiene)) print('version', z.read('VERSION').decode().strip()) print('contains promptbranch_cli', 'promptbranch_cli.py' in names) if hygiene[:20]: print(hygiene[:20]) PY

