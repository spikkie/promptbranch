#!/usr/bin/env bash
set -euo pipefail
scenario="${PROMPTBRANCH_REPLAY_SCENARIO:-success}"
trace_file="${PROMPTBRANCH_REPLAY_TRACE:-}"
if [[ -n "${trace_file}" ]]; then
  mkdir -p "$(dirname "${trace_file}")"
  {
    printf '%s' "${scenario}"
    for arg in "$@"; do
      printf '\t%s' "${arg}"
    done
    printf '\n'
  } >> "${trace_file}"
fi
args=("$@")
stripped=()
i=0
while [[ ${i} -lt ${#args[@]} ]]; do
  case "${args[$i]}" in
    --profile-dir)
      i=$((i+2));;
    --profile-lease)
      i=$((i+1));;
    *)
      stripped+=("${args[$i]}"); i=$((i+1));;
  esac
done
json_report='{"ok":true,"action":"test_report","status":"verified","failure_count":0,"suite":{"rate_limit_summary":{"status":"none","cooldown_wait_seconds_total":0,"cooldown_wait_count":0},"release_validation_groups":{"ok":true,"missing_required_groups":[],"groups":{"artifact_json_contracts":{"ok":true},"browser_scheduler_source_lifecycle":{"ok":true},"project_control_surface":{"ok":true}}}}}'
case "${stripped[*]:-}" in
  "test full"*)
    echo '{"ok":true,"action":"test_full","status":"verified","failure_count":0}'
    exit 0;;
  "test report"*)
    echo "${json_report}"
    exit 0;;
  "login-check"*)
    cat <<'JSON'
{"ok":true,"action":"login_check","status":"authenticated","logged_in":true,"current_url":"https://chatgpt.com/g/g-p-replay/c/bootstrap","rate_limit_telemetry":{"backend_api_guardrail_seen":false,"conversation_history_429_seen":false,"rate_limit_modal_detected":false,"cooldown_wait_seconds_total":0}}
JSON
    exit 0;;
  "project-ensure"*)
    if [[ "${scenario}" == "live_project_ensure_challenge" ]]; then
      echo "current_url='https://chatgpt.com/' title='Just a moment...' challenge_detected=True"
      echo '{"ok":false,"action":"project_ensure","status":"docker_live_profile_challenged","challenge_type":"docker_live_profile_challenged","project_url":"https://chatgpt.com/g/g-p-replay/project"}'
      exit 1
    fi
    echo '{"ok":true,"action":"project_ensure","status":"verified","project_name":"itest-replay","project_url":"https://chatgpt.com/g/g-p-replay/project"}'
    exit 0;;
  "use"*)
    echo '{"ok":true,"action":"project_use","status":"selected","project_url":"https://chatgpt.com/g/g-p-replay/project"}'
    exit 0;;
  "ask"*)
    if [[ "${stripped[*]}" == *"--new-task"* ]]; then
      if [[ "${scenario}" == "live_bootstrap_429_guardrail_with_persisted_cooldown" ]]; then
        echo "[rate-limit] waiting for persisted conversation history cooldown | wait_seconds=101.364 path='/app/profile/.conversation_history_rate_limit_until'"
        echo '{"ok":true,"action":"ask","status":"answered","conversation_url":"https://chatgpt.com/g/g-p-replay/c/replay-bootstrap-guardrail","text":"LIVE_CONVERSATION_BOOTSTRAP_0_1_103_10_54","rate_limit_telemetry":{"rate_limit_modal_detected":true,"conversation_history_429_seen":true,"backend_api_guardrail_seen":true,"cooldown_wait_seconds_total":101.364}}'
        exit 0
      fi
      echo '{"ok":true,"action":"ask","status":"answered","conversation_url":"https://chatgpt.com/g/g-p-replay/c/replay-success","text":"LIVE_CONVERSATION_BOOTSTRAP_0_1_103_10_54","rate_limit_telemetry":{"rate_limit_modal_detected":false,"conversation_history_429_seen":false,"backend_api_guardrail_seen":false,"cooldown_wait_seconds_total":0}}'
      exit 0
    fi;;
  "test ask-live"*)
    if [[ "${scenario}" == "ask_live_challenge" ]]; then
      echo '{"ok":false,"action":"test_ask_live","status":"docker_live_profile_challenged","challenge_type":"docker_live_profile_challenged","step_count":1,"failure_count":1,"terminal_challenge":true}'
      exit 1
    fi
    echo '{"ok":true,"action":"test_ask_live","status":"verified","failure_count":0}'
    exit 0;;
  "test visual-artifact-roundtrip"*)
    echo '{"ok":true,"action":"test_visual_artifact_roundtrip","status":"verified","failure_count":0}'
    exit 0;;
  "test release-live"*)
    echo '{"ok":true,"action":"test_release_live","status":"verified","failure_count":0}'
    exit 0;;
  "test import-smoke"*)
    echo '{"ok":true,"action":"package_import_smoke","status":"verified"}'
    exit 0;;
  "artifact guard"*)
    echo '{"ok":true,"status":"guard_passed","failure_count":0,"release_ready":true}'
    exit 0;;
esac
echo "fake pb: unsupported args: $*" >&2
exit 97
