{
  "dependencies": {
    "application_architecture": [
      "compile"
    ],
    "artifact_contracts": [
      "package_runtime"
    ],
    "browser_source_lifecycle": [
      "compile"
    ],
    "impact_planner": [
      "compile"
    ],
    "operational_lifecycle": [
      "application_architecture",
      "project_control_surface"
    ],
    "package_runtime": [
      "compile"
    ],
    "project_control_surface": [
      "compile"
    ],
    "release_pipeline": [
      "compile",
      "project_control_surface",
      "application_architecture"
    ],
    "release_set_planner": [
      "compile",
      "project_control_surface",
      "artifact_contracts"
    ],
    "release_set_rollout": [
      "release_set_planner",
      "release_pipeline",
      "artifact_contracts",
      "compile"
    ],
    "shell_syntax": []
  },
  "groups": {
    "application_architecture": {
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_promptbranch_application_architecture.py",
          "tests/test_promptbranch_application_migration.py"
        ]
      ],
      "modes": [
        "edit",
        "component",
        "candidate"
      ],
      "transport_independent": true
    },
    "artifact_contracts": {
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_artifact_guardian.py",
          "tests/test_promptbranch_artifacts.py",
          "tests/test_promptbranch_test_report.py",
          "tests/test_promptbranch_release_contract.py"
        ]
      ],
      "modes": [
        "component",
        "candidate"
      ],
      "transport_independent": true
    },
    "browser_source_lifecycle": {
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_promptbranch_automation_service.py",
          "tests/test_promptbranch_cli.py",
          "tests/test_promptbranch_shell_scripts.py",
          "-k",
          "scheduler or source_queue or browser_profile_busy or cross_process_profile_lock or live_profile_handoff or same_service_owner or cross_process_profile_handoff"
        ]
      ],
      "modes": [
        "component",
        "candidate"
      ],
      "transport_independent": false
    },
    "compile": {
      "commands": [
        [
          "python3",
          "-m",
          "compileall",
          "-q",
          "."
        ]
      ],
      "modes": [
        "edit",
        "component",
        "candidate"
      ],
      "transport_independent": true
    },
    "impact_planner": {
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_promptbranch_impact_testing.py"
        ]
      ],
      "modes": [
        "edit",
        "component",
        "candidate"
      ],
      "transport_independent": true
    },
    "operational_lifecycle": {
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_promptbranch_operational_evidence.py",
          "tests/test_release_adoption_verification.py"
        ]
      ],
      "modes": [
        "edit",
        "component",
        "candidate"
      ],
      "transport_independent": true
    },
    "package_runtime": {
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_promptbranch_version.py",
          "tests/test_promptbranch_test_suite.py",
          "tests/test_promptbranch_shell_scripts.py",
          "-k",
          "candidate or release_validation_python or package_import or version_surface"
        ]
      ],
      "modes": [
        "component",
        "candidate"
      ],
      "transport_independent": true
    },
    "project_control_surface": {
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_project_control_surface.py"
        ]
      ],
      "modes": [
        "component",
        "candidate"
      ],
      "transport_independent": true
    },
    "release_pipeline": {
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_promptbranch_release_contract.py",
          "tests/test_promptbranch_release_pipeline.py",
          "tests/test_promptbranch_mvp_proof.py",
          "tests/test_promptbranch_mvp_ask_lifecycle.py"
        ]
      ],
      "modes": [
        "edit",
        "component",
        "candidate"
      ],
      "transport_independent": true
    },
    "release_set_planner": {
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_promptbranch_release_set.py"
        ]
      ],
      "modes": [
        "edit",
        "component",
        "candidate"
      ],
      "transport_independent": true
    },
    "release_set_rollout": {
      "commands": [
        [
          "python3",
          "-m",
          "pytest",
          "-q",
          "tests/test_promptbranch_release_set.py",
          "-k",
          "release_set_apply or rollout_evidence or guarded_apply or repository_owned_rollback or release_set_reconcile or release_set_resume"
        ]
      ],
      "modes": [
        "edit",
        "component",
        "candidate"
      ],
      "transport_independent": true
    },
    "shell_syntax": {
      "commands": [
        [
          "bash",
          "-n",
          "chatgpt_claudecode_workflow_release_control.sh"
        ]
      ],
      "modes": [
        "edit",
        "component",
        "candidate"
      ],
      "transport_independent": true
    }
  },
  "rules": [
    {
      "groups": [
        "impact_planner"
      ],
      "patterns": [
        "promptbranch_impact_testing.py",
        ".promptbranch/test-impact-map.json",
        "tests/test_promptbranch_impact_testing.py"
      ],
      "reason": "impact-selection implementation or policy changed"
    },
    {
      "groups": [
        "release_set_planner",
        "release_set_rollout"
      ],
      "patterns": [
        "promptbranch_release_set.py",
        "promptbranch_protocol/schemas/release-set.schema.json",
        "examples/release-set/**",
        "tests/test_promptbranch_release_set.py"
      ],
      "reason": "release-set manifest, dependency ordering, compatibility matrix, or immutable target planning changed"
    },
    {
      "groups": [
        "release_pipeline"
      ],
      "patterns": [
        "promptbranch_release_pipeline.py",
        "promptbranch_release_engine.py",
        ".promptbranch-release.json",
        "tests/test_promptbranch_release_contract.py",
        "tests/test_promptbranch_release_pipeline.py"
      ],
      "reason": "generic release pipeline, release contract, Git ordering, publication, adoption, or current verification changed"
    },
    {
      "groups": [
        "application_architecture"
      ],
      "patterns": [
        "promptbranch_application_architecture.py",
        ".promptbranch-ai.json",
        ".promptbranch/ai-registry.json",
        "promptbranch_protocol/schemas/application.*",
        "tests/test_promptbranch_application_architecture.py",
        "promptbranch_application_migration.py",
        "templates/pbai/**",
        "fixtures/pbai/**",
        "tests/test_promptbranch_application_migration.py"
      ],
      "reason": "PBAI declaration, registry, templates, migration, differential validation, or domain proof changed"
    },
    {
      "groups": [
        "operational_lifecycle",
        "shell_syntax"
      ],
      "patterns": [
        "promptbranch_operational_evidence.py",
        "promptbranch_protocol/schemas/operational.lifecycle.evidence.schema.json",
        "tests/test_promptbranch_operational_evidence.py",
        "chatgpt_claudecode_workflow_release_control.sh"
      ],
      "reason": "operational lifecycle evidence or release controller changed"
    },
    {
      "groups": [
        "package_runtime"
      ],
      "patterns": [
        "promptbranch_test_suite.py",
        "pyproject.toml",
        "requirements.txt",
        "promptbranch_version.py",
        "VERSION",
        "tests/test_candidate_runtime_binding.py",
        "tests/test_promptbranch_version.py"
      ],
      "reason": "candidate runtime, dependency or version surface changed"
    },
    {
      "groups": [
        "artifact_contracts"
      ],
      "patterns": [
        "promptbranch_artifact*.py",
        ".artifact-guardian.yml",
        "tests/test_artifact*.py"
      ],
      "reason": "artifact contract or guardian surface changed"
    },
    {
      "groups": [
        "browser_source_lifecycle"
      ],
      "patterns": [
        "promptbranch_browser_auth/**",
        "promptbranch_automation/**",
        "promptbranch_scheduler.py",
        "promptbranch_source_queue.py",
        "tests/test_project_source*.py",
        "tests/test_promptbranch_automation_service.py"
      ],
      "reason": "browser-backed source lifecycle or scheduler changed"
    },
    {
      "groups": [
        "project_control_surface"
      ],
      "patterns": [
        "docs/**",
        "README.md",
        "UPGRADING.md",
        "PROJECT_SETTINGS.md",
        "AGENTS.md"
      ],
      "reason": "tracked project policy or documentation projection changed"
    },
    {
      "groups": [
        "compile"
      ],
      "patterns": [
        "tests/**"
      ],
      "reason": "test definition changed and must at least compile"
    },
    {
      "groups": [
        "compile"
      ],
      "patterns": [
        "*.py",
        "scripts/*.py",
        "scripts/**/*.py"
      ],
      "reason": "Python implementation changed"
    },
    {
      "groups": [
        "shell_syntax"
      ],
      "patterns": [
        "*.sh",
        "scripts/*.sh",
        "scripts/**/*.sh"
      ],
      "reason": "shell implementation changed"
    },
    {
      "groups": [
        "project_control_surface"
      ],
      "patterns": [
        "*.json",
        "*.yml",
        "*.yaml",
        ".promptbranch/**"
      ],
      "reason": "tracked configuration or contract changed"
    },
    {
      "groups": [
        "release_set_rollout"
      ],
      "patterns": [
        "promptbranch_release_set_rollout.py",
        "scripts/rollback-release-artifact.py",
        "promptbranch_protocol/schemas/release-set-rollout-evidence.schema.json",
        "promptbranch_protocol/schemas/release-set-rollout-reconciliation.schema.json"
      ],
      "reason": "guarded release-set execution, resumable recovery, operator reconciliation, reverse rollback, or tamper-evident rollout evidence changed"
    }
  ],
  "schema": "promptbranch.test.impact_map",
  "schema_version": "1.0"
}
