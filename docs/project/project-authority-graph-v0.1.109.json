{
  "schema": "promptbranch.project.authority_graph",
  "schema_version": "1.0",
  "graph_version": "v0.1.114",
  "repo_id": "chatgpt_claudecode_workflow-2",
  "validation_mode": "read_only",
  "default_conflict_policy": "fail_closed",
  "remote_mutation_allowed": false,
  "domains": [
    {
      "domain": "release.version",
      "description": "Canonical package and release version; VERSION is the sole mutable version authority.",
      "authority": {
        "kind": "repository_file",
        "path": "VERSION",
        "selector": "trimmed_text"
      },
      "projections": [
        {
          "path": "pyproject.toml",
          "type": "toml_dynamic_version_attr",
          "expected_from": "literal",
          "expected": "promptbranch_version.PACKAGE_VERSION"
        },
        {
          "path": "promptbranch_version.py",
          "type": "python_version_file_authority",
          "expected_from": "authority_text",
          "normalizer": "strip_v",
          "authority_file": "VERSION"
        }
      ],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "fail_closed"
    },
    {
      "domain": "project.stable_policy",
      "description": "Stable project principles, authority policy, and mutation boundaries.",
      "authority": {
        "kind": "repository_file",
        "path": "PROJECT_SETTINGS.md",
        "selector": "document"
      },
      "projections": [],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "fail_closed"
    },
    {
      "domain": "agent.operating_instructions",
      "description": "Repository-specific operating instructions for coding and orchestration agents.",
      "authority": {
        "kind": "repository_file",
        "path": "AGENTS.md",
        "selector": "document"
      },
      "projections": [],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "fail_closed"
    },
    {
      "domain": "project.plan_state",
      "description": "Mutable accepted/current, active candidate, slice horizon, and release-mode state.",
      "authority": {
        "kind": "repository_file",
        "path": "docs/project/plan-state.json",
        "selector": "json_object"
      },
      "projections": [
        {
          "path": "docs/project/status.md",
          "type": "markdown_json_tokens",
          "fields": [
            "accepted_current_version",
            "accepted_current_artifact",
            "active_candidate_version",
            "active_candidate_artifact",
            "next_normal_version",
            "next_normal_slice",
            "next_planned_version_after_acceptance"
          ]
        },
        {
          "path": "docs/project/plan.md",
          "type": "markdown_json_tokens",
          "fields": [
            "accepted_current_version",
            "accepted_current_artifact",
            "active_candidate_version",
            "active_candidate_artifact",
            "next_normal_version",
            "next_normal_slice",
            "next_planned_version_after_acceptance"
          ]
        },
        {
          "path": "docs/project/release-status.md",
          "type": "markdown_json_tokens",
          "fields": [
            "accepted_current_version",
            "accepted_current_artifact",
            "active_candidate_version",
            "active_candidate_artifact",
            "next_normal_version",
            "next_normal_slice",
            "next_planned_version_after_acceptance"
          ]
        }
      ],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "fail_closed"
    },
    {
      "domain": "release.configuration",
      "description": "Artifact naming, install preservation, release hooks, and release lifecycle settings.",
      "authority": {
        "kind": "repository_file",
        "path": ".promptbranch-release.yml",
        "selector": "yaml_document"
      },
      "projections": [
        {
          "path": ".promptbranch-release.yml",
          "type": "literal_contains",
          "expected_from": "literal",
          "expected": null,
          "tokens": [
            "version_file: VERSION",
            "prefix: chatgpt_claudecode_workflow-2_",
            "suffix: .zip"
          ]
        }
      ],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "fail_closed"
    },
    {
      "domain": "repository.project_identity",
      "description": "Tracked intended relationship between this repository and its authoritative ChatGPT Project.",
      "authority": {
        "kind": "repository_file",
        "path": ".promptbranch-repo.json",
        "selector": "json_object"
      },
      "projections": [],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "fail_closed"
    },
    {
      "domain": "artifact.adopted_identity",
      "description": "Project-scoped adopted artifact identity; repo/version binds to one SHA-addressed PB object and Project Source/filesystem copies are projections or inputs.",
      "authority": {
        "kind": "runtime_registry",
        "selector": "current_adopted_record",
        "resolver": "project_registry_file(project_id)",
        "location_contract": "user_state/promptbranch/projects/<project_id>/promptbranch_artifacts.json",
        "object_location_contract": "user_state/promptbranch/projects/<project_id>/objects/<sha256>/<canonical-filename>",
        "identity_key": "repo_id+version+sha256",
        "filename_is_identity": false
      },
      "projections": [],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "deferred_until_runtime",
      "required_for_runtime_validation": true
    },
    {
      "domain": "chatgpt.project_settings",
      "description": "Remote ChatGPT Project Settings as externally owned observed state.",
      "authority": {
        "kind": "external_observation",
        "system": "ChatGPT",
        "surface": "Project Settings"
      },
      "projections": [],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "report_unresolved",
      "required_for_runtime_validation": false,
      "observation_policy": "read_only",
      "mutation_allowed": false
    },
    {
      "domain": "project.behavioral_surface",
      "description": "Stable identity, ownership, consumers, execution boundaries, risk, tests, and contracts for executable instructions, skills/agents, tools, and prompts.",
      "authority": {
        "kind": "repository_file",
        "path": "docs/project/promptbranch-behavioral-surface-v0.1.109.1.json",
        "selector": "json_object"
      },
      "projections": [
        {
          "path": "docs/project/behavioral-surface.md",
          "type": "literal_contains",
          "expected_from": "literal",
          "expected": null,
          "tokens": [
            "promptbranch.project.behavioral_surface",
            "v0.1.109.1",
            "pb project behavioral-surface validate"
          ]
        }
      ],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "fail_closed"
    },
    {
      "domain": "ai.application_architecture",
      "description": "Tracked PBAI-001 application kind, version authority, ten layers, delegation, bounded authority, and project-local validation commands.",
      "authority": {
        "kind": "repository_file",
        "path": ".promptbranch-ai.json",
        "selector": "json_object"
      },
      "projections": [
        {
          "path": "PROJECT_SETTINGS.md",
          "type": "literal_contains",
          "expected_from": "literal",
          "expected": "PBAI-001",
          "tokens": [
            "PBAI-001",
            ".promptbranch-ai.json",
            "Every Promptbranch runtime application"
          ]
        },
        {
          "path": "AGENTS.md",
          "type": "literal_contains",
          "expected_from": "literal",
          "expected": "PBAI-001",
          "tokens": [
            "PBAI-001",
            ".promptbranch-ai.json",
            "application architecture validate"
          ]
        }
      ],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "fail_closed"
    },
    {
      "domain": "ai.application_registry",
      "description": "Tracked PBAI-001 Agent, Skill, Tool, Validator, state, evidence, capability, and bounded authority reference registry.",
      "authority": {
        "kind": "repository_file",
        "path": ".promptbranch/ai-registry.json",
        "selector": "json_object"
      },
      "projections": [
        {
          "path": "PROJECT_SETTINGS.md",
          "type": "literal_contains",
          "expected_from": "literal",
          "expected": "PBAI-001 registry",
          "tokens": [
            ".promptbranch/ai-registry.json",
            "registry validation",
            "reference"
          ]
        },
        {
          "path": "AGENTS.md",
          "type": "literal_contains",
          "expected_from": "literal",
          "expected": "PBAI-001 registry",
          "tokens": [
            ".promptbranch/ai-registry.json",
            "--level registry",
            "fail closed"
          ]
        }
      ],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "fail_closed"
    },
    {
      "domain": "project.authority_graph",
      "description": "Fact-domain ownership declarations and validation rules.",
      "authority": {
        "kind": "repository_file",
        "path": "docs/project/project-authority-graph-v0.1.109.json",
        "selector": "json_object"
      },
      "projections": [],
      "conflict_policy": "fail_closed",
      "missing_authority_policy": "fail_closed"
    }
  ]
}
