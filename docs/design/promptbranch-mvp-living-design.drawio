        <mxCell id="s-title" value="v0.1.31 Strict --skip-source-add Preservation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;align=left;verticalAlign=top;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s-input" value="Operator intent&#10;&#10;release-control --install-from-zip ... --skip-source-add&#10;&#10;Focused install/checkpoint/smoke must stay local-only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="s-delegate" value="Stage-0 delegation guard&#10;&#10;Outer script detects --skip-source-add before execing candidate workflow.&#10;&#10;Exports:&#10;PROMPTBRANCH_RELEASE_SKIP_SOURCE_ADD=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="s-output" value="Mutation blocked&#10;&#10;Project Source add requires both guards open:&#10;- skip_source_add == 0&#10;- PROMPTBRANCH_RELEASE_SKIP_SOURCE_ADD != 1&#10;&#10;Otherwise prints:&#10;Source add skipped: --skip-source-add" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1060" y="140" width="420" height="250" as="geometry" />
