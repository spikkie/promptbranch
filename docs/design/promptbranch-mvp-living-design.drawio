        <mxCell id="actual_docs" value="Core MVP docs&#10;&#10;High-level canvas:&#10;orchestration/docs/json_orchestration_state_mvp_v0_1_0_high_level_canvas.md&#10;&#10;Low-level canvas:&#10;orchestration/docs/json_orchestration_state_mvp_v0_1_0_low_level_canvas.md&#10;&#10;Use high-level for intent/architecture.&#10;Use low-level for repo layout/scope/setup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
