        <mxCell id="done" value="Done / current surface&#10;&#10;- canonical shell grammar&#10;- read-only MCP server/client paths&#10;- skill registry / repo-inspection model&#10;- pb test smoke&#10;- ask/reply + artifact intake design&#10;- release doctor/config/install/lifecycle planning&#10;- dev-status/checkpoint&#10;- baseline-status after adoption&#10;- docs-status validation&#10;- living design + draw.io source&amp;#10;- ask/reply JSON data-flow diagram page documents operational JSON handoffs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="1190" width="470" height="290" as="geometry" />
        </mxCell>
        <mxCell id="remaining" value="Remaining / planned&#10;&#10;JSON orchestration state MVP:&#10;- add more schema-backed proof examples&#10;- prove real artifact roundtrip&#10;- connect candidate intake to guarded adoption&#10;&#10;Lifecycle:&#10;- controlled source upload/test/adopt&#10;- policy sync + git safety&#10;&#10;Agent/MCP:&#10;- harden host loop&#10;- writes remain blocked until transactional proof exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="535" y="1190" width="470" height="290" as="geometry" />
        </mxCell>
        <mxCell id="docs_refs" value="Documentation references&#10;&#10;Actual MVP:&#10;- orchestration/docs/json_orchestration_state_mvp.md&#10;- orchestration/docs/json_orchestration_state_mvp_v0_1_0_high_level_canvas.md&#10;- orchestration/docs/json_orchestration_state_mvp_v0_1_0_low_level_canvas.md&#10;&#10;Support docs:&#10;- operating model&#10;- MCP/skills plan&#10;- ask/reply artifact intake&#10;- native release lifecycle TODO&amp;#10;- Ask Reply JSON Data Flow page in this draw.io source&amp;#10;- docs/release-v0.1.26.md&amp;#10;- docs/release-v0.1.27.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1190" width="470" height="290" as="geometry" />
        </mxCell>
        <mxCell id="update_sec" value="7. Update protocol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="1530" width="1480" height="42" as="geometry" />
        </mxCell>
        <mxCell id="update" value="After each release slice:&#10;1. Keep ACTUAL MVP: json_orchestration_state_mvp visible unless the MVP line changes.&#10;2. Update this Markdown and the editable .drawio together.&#10;3. Keep references repo-relative.&#10;4. Move items to Done only after focused tests or full release-control evidence exists.&#10;5. Run: pb release docs-status --json.&#10;6. After adoption, run: pb release baseline-status --json.&#10;7. Do not export images unless explicitly requested." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="1590" width="1480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="threshold_projection_v0125" value="v0.1.25 threshold projection clarification&#10;&#10;If current dev head is near threshold but the next release does not reach it yet, expected_threshold_version = projected threshold candidate.&#10;&#10;Example: accepted v0.1.18.1, dev v0.1.24, remaining 2 → expected threshold v0.1.26; v0.1.25 can still be focused development." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="535" y="1510" width="470" height="150" as="geometry" />
        </mxCell>
