0.1.125.1 compileall repair.&lt;br&gt;No external application development, Project Source mutation, adoption, Git commit, Git push, or deployment during construction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="410" y="470" width="760" height="150" as="geometry" /></mxCell><mxCell id="e1" value="normal candidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="baseline" target="failed"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="repair required" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="failed" target="repair"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="only after green test + explicit acceptance" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="repair" target="next"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>