        <mxCell id="actual_mvp" value="ACTUAL MVP&#10;json_orchestration_state_mvp&#10;&#10;Source of truth:&#10;- orchestration/docs/json_orchestration_state_mvp.md&#10;- high-level canvas&#10;- low-level canvas&#10;&#10;This diagram is a living map around that MVP, not a competing MVP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="190" width="470" height="230" as="geometry" />
        </mxCell>
        <mxCell id="actual_docs" value="Core MVP docs&#10;&#10;High-level canvas:&#10;orchestration/docs/json_orchestration_state_mvp_v0_1_0_high_level_canvas.md&#10;&#10;Low-level canvas:&#10;orchestration/docs/json_orchestration_state_mvp_v0_1_0_low_level_canvas.md&#10;&#10;Use high-level for intent/architecture.&#10;Use low-level for repo layout/scope/setup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="450" width="470" height="250" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="Typed orchestration loop&#10;&#10;Intent&#10;→ ChatGPT grill proposal&#10;→ Promptbranch schema/policy validation&#10;→ accepted/rejected JSON event&#10;→ evidence collection&#10;→ release artifact candidate&#10;→ artifact intake verification&#10;→ guarded adoption&#10;→ next task from known state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="535" y="190" width="470" height="250" as="geometry" />
        </mxCell>
        <mxCell id="authority" value="Authority split&#10;&#10;ChatGPT = deliberation + grilling engine&#10;JSON = typed proposal/event/evidence contract&#10;Promptbranch = deterministic control-plane state machine&#10;Tools/tests/deployment = evidence producers&#10;Artifact intake = release ingress/adoption gate&#10;&#10;Rule: proposal is not authority." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="535" y="470" width="470" height="230" as="geometry" />
        </mxCell>
        <mxCell id="shell" value="Promptbranch shell model&#10;&#10;Workspace = ChatGPT Project&#10;Task = ChatGPT chat/session&#10;Artifact = repo/source bundle/release ZIP&#10;&#10;Canonical grammar:&#10;pb ws / pb task / pb src / pb artifact / pb test / pb debug / pb doctor / pb ask / pb agent / pb mcp / pb skill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="190" width="470" height="230" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="Local execution architecture&#10;&#10;Promptbranch CLI/local host&#10;→ deterministic planner/policy gate&#10;→ MCP client&#10;→ pb mcp serve&#10;→ read-only tools first&#10;→ controlled process tools later&#10;→ transactional writes only after verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="450" width="470" height="250" as="geometry" />
        </mxCell>
