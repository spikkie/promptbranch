        <mxCell id="e_actual_docs" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="actual_mvp" target="actual_docs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="evidence_sec" value="4. Evidence and artifact intake gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="760" width="720" height="42" as="geometry" />
        </mxCell>
        <mxCell id="dev_sec" value="5. Development / adoption flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="760" width="720" height="42" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="Evidence model&#10;&#10;JSON surfaces:&#10;- context.schema.json&#10;- decision.schema.json&#10;- evidence.schema.json&#10;&#10;Examples + state machines prove the contract shape.&#10;&#10;Evidence is produced by tools/tests/deployment, not by assistant prose." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="820" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="artifact_gate" value="Artifact intake gate&#10;&#10;structured ask&#10;→ structured reply&#10;→ candidate artifact&#10;→ download only when explicit&#10;→ verify ZIP/layout/hygiene/version&#10;→ migrate as candidate&#10;→ full test/adopt only after green validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="820" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="devflow" value="CI-style development flow&#10;&#10;accepted baseline may remain behind runtime/dev head&#10;&#10;focused dev:&#10;v0.1.7.1 → v0.1.8 → v0.1.9 → v0.1.10 → v0.1.12 → v0.1.14 → v0.1.15 → v0.1.16 → v0.1.17 → v0.1.18 → v0.1.18.1 → v0.1.19 → v0.1.20 → v0.1.21 → v0.1.22 → v0.1.23 → v0.1.24 → v0.1.25 → v0.1.26 → v0.1.27&#10;&#10;full release-control at adoption checkpoint; baseline-status verifies reset; status-guide selects checkpoint/dev-status/baseline-status, emits a read-only runbook, shows the full-test threshold meter, and warns when the next release is expected to trigger full-test/adoption and, at threshold, gives an actionable full-test/adopt-current preparation runbook and then continues with post-adoption next-normal plus next-candidate checkpoint/status-guide handoff, with JSON and plain-text outputs both showing the next artifact and after-build commands, and smoke validating the non-JSON status-guide handoff contract and pre-threshold full-test countdown fields, with v0.1.25 correcting expected_threshold_version so it projects the actual threshold candidate instead of always naming the immediate next candidate&#10;&#10;v0.1.26 adds an ask/reply JSON data-flow diagram page and keeps the threshold candidate intentionally documentation/data-flow focused.&#10;&#10;v0.1.27 starts after v0.1.26 adoption/full-test evidence and adds baseline-status next-development handoff fields so the post-adoption verifier also points at the next artifact and after-build status-guide/checkpoint commands.&#10;&#10;Do not rewrite issued versions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="820" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="checkpoint" value="Checkpoint decision&#10;&#10;Continue mode:&#10;- focused tests&#10;- smoke&#10;- docs-status&#10;- no source/adopt mutation&#10;&#10;Adopt mode:&#10;- full release-control&#10;- Project Source verification&#10;- artifact current verified&#10;- policy/Git sync only when safe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1170" y="820" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="e_loop_evidence" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="loop" target="evidence">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_evidence_artifact" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1" source="evidence" target="artifact_gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_artifact_dev" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="artifact_gate" target="devflow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dev_checkpoint" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="devflow" target="checkpoint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="current_sec" value="6. Current implemented surface / remaining movement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="1130" width="1480" height="42" as="geometry" />
        </mxCell>
        <mxCell id="done" value="Done / current surface&#10;&#10;- canonical shell grammar&#10;- read-only MCP server/client paths&#10;- skill registry / repo-inspection model&#10;- pb test smoke&#10;- ask/reply + artifact intake design&#10;- release doctor/config/install/lifecycle planning&#10;- dev-status/checkpoint&#10;- baseline-status after adoption&#10;- docs-status validation&#10;- living design + draw.io source&amp;#10;- ask/reply JSON data-flow diagram page documents operational JSON handoffs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="1190" width="470" height="290" as="geometry" />
        </mxCell>
        <mxCell id="remaining" value="Remaining / planned&#10;&#10;JSON orchestration state MVP:&#10;- add more schema-backed proof examples&#10;- prove real artifact roundtrip&#10;- connect candidate intake to guarded adoption&#10;&#10;Lifecycle:&#10;- controlled source upload/test/adopt&#10;- policy sync + git safety&#10;&#10;Agent/MCP:&#10;- harden host loop&#10;- writes remain blocked until transactional proof exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="535" y="1190" width="470" height="290" as="geometry" />
        </mxCell>
        <mxCell id="docs_refs" value="Documentation references&#10;&#10;Actual MVP:&#10;- docs/design/orchestration/docs/json_orchestration_state_mvp.md&#10;- docs/design/orchestration/docs/json_orchestration_state_mvp_v0_1_0_high_level_canvas.md&#10;- docs/design/orchestration/docs/json_orchestration_state_mvp_v0_1_0_low_level_canvas.md&#10;&#10;Support docs:&#10;- operating model&#10;- MCP/skills plan&#10;- ask/reply artifact intake&#10;- native release lifecycle TODO&amp;#10;- Ask Reply JSON Data Flow page in this draw.io source&amp;#10;- docs/release-v0.1.26.md&amp;#10;- docs/release-v0.1.27.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1190" width="470" height="290" as="geometry" />
        </mxCell>
        <mxCell id="update_sec" value="7. Update protocol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=center;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="1530" width="1480" height="42" as="geometry" />
        </mxCell>
        <mxCell id="update" value="After each release slice:&#10;1. Keep ACTUAL MVP: json_orchestration_state_mvp visible unless the MVP line changes.&#10;2. Update this Markdown and the editable .drawio together.&#10;3. Keep references repo-relative.&#10;4. Move items to Done only after focused tests or full release-control evidence exists.&#10;5. Run: pb release docs-status --json.&#10;6. After adoption, run: pb release baseline-status --json.&#10;7. Do not export images unless explicitly requested." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="1590" width="1480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="threshold_projection_v0125" value="v0.1.25 threshold projection clarification&#10;&#10;If current dev head is near threshold but the next release does not reach it yet, expected_threshold_version = projected threshold candidate.&#10;&#10;Example: accepted v0.1.18.1, dev v0.1.24, remaining 2 → expected threshold v0.1.26; v0.1.25 can still be focused development." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="535" y="1510" width="470" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
