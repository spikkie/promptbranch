        <mxCell id="evidence" value="Evidence model&#10;&#10;JSON surfaces:&#10;- context.schema.json&#10;- decision.schema.json&#10;- evidence.schema.json&#10;&#10;Examples + state machines prove the contract shape.&#10;&#10;Evidence is produced by tools/tests/deployment, not by assistant prose." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="820" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="artifact_gate" value="Artifact intake gate&#10;&#10;structured ask&#10;→ structured reply&#10;→ candidate artifact&#10;→ download only when explicit&#10;→ verify ZIP/layout/hygiene/version&#10;→ migrate as candidate&#10;→ full test/adopt only after green validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="410" y="820" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="devflow" value="CI-style development flow&#10;&#10;accepted baseline may remain behind runtime/dev head&#10;&#10;focused dev:&#10;v0.1.7.1 → v0.1.8 → v0.1.9&#10;&#10;full release-control only at adoption checkpoint&#10;&#10;Do not rewrite issued versions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="820" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="checkpoint" value="Checkpoint decision&#10;&#10;Continue mode:&#10;- focused tests&#10;- smoke&#10;- docs-status&#10;- no source/adopt mutation&#10;&#10;Adopt mode:&#10;- full release-control&#10;- Project Source verification&#10;- artifact current verified&#10;- policy/Git sync only when safe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
