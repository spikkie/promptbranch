  <diagram id="checkpoint-warning-context-v0133" name="Checkpoint Warning Context">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c-title" value="v0.1.33 Checkpoint Continue-Mode Warning Context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;align=left;verticalAlign=top;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c-context" value="Focused development checkpoint&#10;&#10;Accepted baseline may lag behind runtime/dev head.&#10;&#10;Continue mode is read-only and does not adopt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c-warning" value="Install-plan warning remains data&#10;&#10;release_install_candidate_not_next_normal_version can be true because accepted baseline is older.&#10;&#10;For explicit continue-mode dev head it is contextual evidence, not a top-level checkpoint risk." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="420" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c-output" value="Operator output&#10;&#10;Top-level warning_codes focus on actionable checkpoint risks.&#10;&#10;contextualized_warning_codes records the suppressed install-plan warning.&#10;&#10;Adopt mode still promotes the warning." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1" vertex="1" parent="1">
