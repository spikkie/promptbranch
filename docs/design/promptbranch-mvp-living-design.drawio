          <mxGeometry x="40" y="30" width="1460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-problem" value="Problem before v0.1.30&#10;&#10;Operator runs baseline-status for an installed development candidate before adoption.&#10;The command correctly reports post-adoption-only context, but its suggested checkpoint command may combine the candidate version with the accepted-baseline ZIP path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="b-fix" value="Read-only fix&#10;&#10;If no explicit --artifact is supplied and a matching local candidate ZIP exists, baseline-status now uses that candidate path for the checkpoint handoff.&#10;&#10;New payload fields:&#10;- development_checkpoint_artifact&#10;- development_checkpoint_artifact_source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="b-output" value="Desired handoff&#10;&#10;pb release checkpoint \&#10;  --artifact ./chatgpt_claudecode_workflow-2_v0.1.30.zip \&#10;  --version v0.1.30 \&#10;  --target-version v0.1.30 \&#10;  --mode continue \&#10;  --json&#10;&#10;No adoption, no source upload, no tests are run by baseline-status." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=top;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1060" y="140" width="420" height="260" as="geometry" />
        </mxCell>
        <mxCell id="b-e1" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="b-problem" target="b-fix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b-e2" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="b-fix" target="b-output">
          <mxGeometry relative="1" as="geometry" />
