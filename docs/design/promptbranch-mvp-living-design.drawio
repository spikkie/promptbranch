          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_shell_mcp" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="shell" target="mcp">
          <mxGeometry relative="1" as="geometry" />
