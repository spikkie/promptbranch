endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="a126" target="a127"><mxGeometry x="0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="a128" value="&lt;b&gt;v0.1.128&lt;/b&gt;&lt;br&gt;environment freeze" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;shadow=0" vertex="1" parent="1"><mxGeometry x="80" y="730" width="350" height="92" as="geometry"/></mxCell><mxCell id="ae3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#d6b656;strokeWidth=2;endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="a127" target="a128"><mxGeometry x="0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="Agate" value="&lt;b&gt;Environment contract frozen&lt;/b&gt;&lt;br&gt;PB is ready to govern an external pilot; this is not yet app success." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;shadow=0;fontStyle=1" vertex="1" parent="1"><mxGeometry x="480" y="490" width="390" height="170" as="geometry"/></mxCell><mxCell id="eAg" value="exit gate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#9673a6;strokeWidth=3;endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="a128" target="Agate"><mxGeometry x="0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="hB" value="&lt;b&gt;External application release line&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=20;fontColor=#1f2937;align=left;verticalAlign=middle;spacing=8;shadow=0;fontStyle=1;resizable=0;movable=1" vertex="1" parent="1"><mxGeometry x="980" y="310" width="850" height="40" as="geometry"/></mxCell><mxCell id="b129" value="&lt;b&gt;v0.1.129&lt;/b&gt;&lt;br&gt;read-only bootstrap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;shadow=0" vertex="1" parent="1"><mxGeometry x="1020" y="370" width="360" height="86" as="geometry"/></mxCell><mxCell id="b130" value="&lt;b&gt;v0.1.130&lt;/b&gt;&lt;br&gt;controlled change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;shadow=0" vertex="1" parent="1"><mxGeometry x="1020" y="475" width="360" height="86" as="geometry"/></mxCell><mxCell id="be1" value="future" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1" edge="1" parent="1" source="b129" target="b130"><mxGeometry x="0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="b131" value="&lt;b&gt;v0.1.131&lt;/b&gt;&lt;br&gt;test/diagnose/correct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;shadow=0" vertex="1" parent="1"><mxGeometry x="1020" y="580" width="360" height="86" as="geometry"/></mxCell><mxCell id="be2" value="future" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1" edge="1" parent="1" source="b130" target="b131"><mxGeometry x="0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="b132" value="&lt;b&gt;v0.1.132&lt;/b&gt;&lt;br&gt;app candidate + acceptance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;shadow=0" vertex="1" parent="1"><mxGeometry x="1020" y="685" width="360" height="86" as="geometry"/></mxCell><mxCell id="be3" value="future" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1" edge="1" parent="1" source="b131" target="b132"><mxGeometry x="0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="b133" value="&lt;b&gt;v0.1.133&lt;/b&gt;&lt;br&gt;non-prod deployment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;shadow=0" vertex="1" parent="1"><mxGeometry x="1020" y="790" width="360" height="86" as="geometry"/></mxCell><mxCell id="be4" value="future" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1" edge="1" parent="1" source="b132" target="b133"><mxGeometry x="0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="b134" value="&lt;b&gt;v0.1.134&lt;/b&gt;&lt;br&gt;reusable/multi-repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;shadow=0" vertex="1" parent="1"><mxGeometry x="1020" y="895" width="360" height="86" as="geometry"/></mxCell><mxCell id="be5" value="future" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1" edge="1" parent="1" source="b133" target="b134"><mxGeometry x="0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="bridge" value="explicit pilot decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#d6b656;strokeWidth=3;endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1" edge="1" parent="1" source="Agate" target="b129"><mxGeometry x="0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Non-negotiable authority separation&lt;/b&gt;&lt;br&gt;&lt;br&gt;• PB tests prove PB only.&lt;br&gt;• App tests prove the app only.&lt;br&gt;• PB artifact/current state and app artifact/current state are separate.&lt;br&gt;• App mutation requires app-specific allowlists, snapshot, rollback, and operator authority.&lt;br&gt;• App acceptance or deployment cannot be inferred from PB environment success." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontColor=#111827;align=left;verticalAlign=middle;spacing=8;shadow=0" vertex="1" parent="1"><mxGeometry x="330" y="1000" width="1240" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
