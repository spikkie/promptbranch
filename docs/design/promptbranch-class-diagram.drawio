"0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="rule" value="&lt;b&gt;Authority rule&lt;/b&gt;&lt;br&gt;ChatGPT may reason, grill, and propose. PB validates deterministic contracts and evidence. The operator authorizes mutation, acceptance, publication, and deployment. An external app never inherits authority merely because the PB environment passed its own tests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;shadow=0" vertex="1" parent="1"><mxGeometry x="300" y="1010" width="1200" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pb-control-vs-app-roadmap-v0125" name="Control Plane vs Application Plane — Roadmap"><mxGraphModel dx="1900" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Promptbranch control plane and external application plane&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=24;fontColor=#1f2937;align=center;verticalAlign=middle;spacing=8;shadow=0;fontStyle=1;resizable=0;movable=1" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1800" height="55" as="geometry"/></mxCell><mxCell id="op" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;authorizes mutation, acceptance, publication and deployment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;shadow=0;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="125" width="300" height="120" as="geometry"/></mxCell><mxCell id="pb" value="&lt;b&gt;System A: Promptbranch&lt;/b&gt;&lt;br&gt;CLI • state • policy • evidence • browser • candidate lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;shadow=0;fontStyle=1" vertex="1" parent="1"><mxGeometry x="430" y="115" width="500" height="140" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;System B: External application&lt;/b&gt;&lt;br&gt;product • source • tests • artifact • accepted baseline • deployment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=17;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;shadow=0;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1000" y="115" width="560" height="140" as="geometry"/></mxCell><mxCell id="env" value="&lt;b&gt;Deployment environment&lt;/b&gt;&lt;br&gt;non-production first; explicit adapter and rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;shadow=0" vertex="1" parent="1"><mxGeometry x="1630" y="125" width="220" height="120" as="geometry"/></mxCell><mxCell id="e1" value="commands + approvals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#6c8ebf;strokeWidth=3;endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff" edge="1" parent="1" source="op" target="pb"><mxGeometry x="0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="e2" value="bounded execution envelope" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#d6b656;strokeWidth=3;endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1" edge="1" parent="1" source="pb" target="app"><mxGeometry x="0" y="0" width="0" height="0" relative="1" as="geometry"/></mxCell><mxCell id="e3" value="explicit deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;