        <mxCell id="e_cap" value="source cap / visibility" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="n5" target="sourcecap">
          <mxGeometry relative="1" as="geometry" />
