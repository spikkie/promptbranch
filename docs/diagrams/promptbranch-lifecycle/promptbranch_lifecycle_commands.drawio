        <mxCell id="e_lifecycle" value="expands into stages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="future" target="n4">
