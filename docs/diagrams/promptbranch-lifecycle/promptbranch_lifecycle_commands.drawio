        <mxCell id="rel8" value="Next development base&#10;normal version +1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;arcSize=10;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
