        <mxCell id="e_next" value="next release uses current baseline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="sync" target="n2">
          <mxGeometry relative="1" as="geometry" />
