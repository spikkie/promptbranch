<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-05-27T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram id="promptbranch-lifecycle" name="PB lifecycle commands"><mxGraphModel dx="1800" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Promptbranch Lifecycle &amp; Command Map&lt;/b&gt;&lt;br/&gt;Command-line driven release flow: workspace → task → candidate → verify → source → test → adopt → sync → next ask" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="60" as="geometry"/></mxCell><mxCell id="context" value="&lt;b&gt;Core state scopes&lt;/b&gt;&lt;br/&gt;Workspace = ChatGPT Project &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; Task = chat/conversation &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; Artifact = release ZIP/source bundle/current baseline&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;State must not conflate these scopes; commands should update only the scope they own.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1720" height="95" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;1. Select workspace/task/baseline&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pb ws list/use/current&lt;br/&gt;pb task list/use/current/show&lt;br/&gt;pb artifact current --json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="250" width="540" height="115" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;2. Structured ask&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pb ask &quot;...&quot; --protocol --from-current-baseline --json&lt;br/&gt;pb task answer parse --latest --json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="400" width="540" height="115" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;3. Candidate intake&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pb artifact intake --from-last-answer --json&lt;br/&gt;pb artifact intake --from-last-answer --download --verify --migrate --json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="550" width="540" height="115" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;4. Doctor / precheck&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pb doctor&lt;br/&gt;pb release doctor --artifact ZIP --version VERSION --json&lt;br/&gt;pb src list --json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="700" width="540" height="115" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;5. Install candidate + add Project Source&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;./chatgpt_claudecode_workflow_release_control.sh --version V --install-from-zip ZIP --run-tests&lt;br/&gt;future: pb release install --artifact ZIP --version V&lt;br/&gt;pb src add ZIP; verify source visible&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="850" width="540" height="115" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;6. Project tests / acceptance hooks&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pb test smoke --json&lt;br/&gt;pb test full --json&lt;br/&gt;pb test report LOG --json&lt;br/&gt;future: pb release test --artifact ZIP --version V --json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="1040" width="540" height="115" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;8. Adopt + verify current&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;./chatgpt_claudecode_workflow_release_control.sh --version V --tests-only --adopt-if-green&lt;br/&gt;pb artifact adopt ZIP --from-project-source --local-path ZIP&lt;br/&gt;pb artifact current --json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="1240" width="540" height="115" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Green?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tests + source + baseline&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="1175" width="180" height="95" as="geometry"/></mxCell><mxCell id="sourcecap" value="&lt;b&gt;Source capacity guard&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;When adding a new release source and there are already 25 sources:&lt;br/&gt;1. snapshot current sources&lt;br/&gt;2. find same-family versioned release ZIPs&lt;br/&gt;3. remove the lowest version&lt;br/&gt;4. add new ZIP&lt;br/&gt;5. re-read and verify persistence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="840" width="430" height="160" as="geometry"/></mxCell><mxCell id="fail" value="&lt;b&gt;Fail-closed recovery path&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;If invalid/missing envelope, bad ZIP, source not visible, tests red, adoption mismatch, or stale baseline:&lt;br/&gt;&lt;br/&gt;pb debug sources --json&lt;br/&gt;pb release doctor --json&lt;br/&gt;pb artifact candidates --json&lt;br/&gt;inspect release logs&lt;br/&gt;do not adopt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="1120" width="430" height="180" as="geometry"/></mxCell><mxCell id="sync" value="&lt;b&gt;9. Post-adoption sync&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;update .promptbranch-project.json&lt;br/&gt;accepted_baseline = adopted artifact&lt;br/&gt;git status&lt;br/&gt;git add expected files only&lt;br/&gt;git commit &quot;Release &amp;lt;repo&amp;gt; &amp;lt;version&amp;gt;&quot;&lt;br/&gt;git push&lt;br/&gt;pb ask &quot;Continue&quot; --protocol --from-current-baseline --json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="1240" width="430" height="170" as="geometry"/></mxCell><mxCell id="future" value="&lt;b&gt;Target native lifecycle command&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pb release lifecycle \
  --version V \
  --artifact ZIP \
  --json&lt;br/&gt;&lt;br/&gt;Should orchestrate:&lt;br/&gt;doctor → install → source add → hooks/tests → adopt → current verify → policy sync → git safety → summary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="250" width="390" height="220" as="geometry"/></mxCell><mxCell id="control" value="&lt;b&gt;Control-plane command groups&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pb ws ...&lt;br/&gt;pb task ...&lt;br/&gt;pb ask ...&lt;br/&gt;pb src ...&lt;br/&gt;pb artifact ...&lt;br/&gt;pb release ...&lt;br/&gt;pb test ...&lt;br/&gt;pb doctor&lt;br/&gt;pb debug ...&lt;br/&gt;pb agent ...&lt;br/&gt;pb mcp ...&lt;br/&gt;pb skill ...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="520" width="390" height="260" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;Local agent / MCP support&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;pb mcp serve --path .&lt;br/&gt;pb mcp manifest --json&lt;br/&gt;pb agent run &quot;read VERSION and git status&quot; --path . --json&lt;br/&gt;pb skill list/show/validate&lt;br/&gt;&lt;br/&gt;Read-only by default; write/process/destructive actions require deterministic gates.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="830" width="390" height="230" as="geometry"/></mxCell><mxCell id="invariants" value="&lt;b&gt;Safety invariants&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;• ZIP artifacts immutable&lt;br/&gt;• VERSION inside ZIP matches candidate&lt;br/&gt;• candidate before accepted baseline&lt;br/&gt;• no auto-adoption from assistant prose&lt;br/&gt;• backend-first reads&lt;br/&gt;• transactional writes&lt;br/&gt;• verify before state update&lt;br/&gt;• fail closed on ambiguity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;spacing=10;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="1110" width="390" height="260" as="geometry"/></mxCell><mxCell id="e1" value="OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n6" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="gate" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_fail" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="gate" target="fail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_adopt_sync" value="verified" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n8" target="sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_cap" value="source cap / visibility" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="n5" target="sourcecap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_next" value="next release uses current baseline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="sync" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_lifecycle" value="expands into stages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="future" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
