        <mxCell id="e_adopt_sync" value="verified" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="n8" target="sync">
          <mxGeometry relative="1" as="geometry" />
